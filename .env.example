# Host port for the web interface and public API.
# For example, WEB_PORT=9090 makes it available at http://localhost:9090.
# Compose binds this port to localhost by default.
WEB_PORT=8080

# Maximum accepted upload size.
MAX_UPLOAD_MB=50

# Backend request timeout in seconds.
BACKEND_TIMEOUT_SECONDS=900

# Maximum time to wait for SeedVR2 to confirm that PyTorch VRAM was released.
# A job is not marked complete until this cleanup check finishes or times out.
GPU_RELEASE_TIMEOUT_SECONDS=30

# Exact upstream revisions used by the tested stack.
CLEANER_COMMIT=5389c6a3bd0eb245ea380bcfcf4c75845709d2da
COMFYUI_COMMIT=9cf91339b708a245762fa38ffeec9702b381e0db
SEEDVR_REVISION=7694e0f361dde8521668e9f8e1d242a1ee90035a

# Optional Hugging Face token. The current model files are public.
HF_TOKEN=
